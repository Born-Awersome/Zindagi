# Optional local configuration. Never put credentials in this example.
PORT=3001
DATABASE_PATH=data/zindagi.sqlite
# For HTTPS deployment only, uncomment and change the public origin:
# NODE_ENV=production
# APP_ORIGIN=https://your-domain.example
# Optional native HTTPS for LAN use. Both files are required.
# Include the host PC's LAN IP in the certificate and trust its CA on each device.
# HTTPS_CERT=certs/lan.pem
# HTTPS_KEY=certs/lan-key.pem
# HOST=0.0.0.0
